---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { getCollection } from 'astro:content';

let jobs: any[] = [];
try {
  const raw = await import('../data/jobs.json');
  jobs = Array.isArray(raw.default) ? raw.default : [];
} catch {
  // jobs.json がまだない場合はスキップ
}

const guides = await getCollection('guides');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 外部求人サービス（URLは運営者が確認・更新してください）
const externalLinks = [
  {
    name: 'ハローワーク 障害者求人',
    desc: '公共職業安定所が運営する求人検索サービスです。障害者専用の求人を探せます。',
    url: 'https://jsite.mhlw.go.jp/osaka-hellowork/kanren/syougaisya_kantan_kensaku.html',
    label: 'ハローワーク インターネットサービス',
  },
  {
    name: 'atGP',
    desc: '障害のある方向けの転職・就職支援サービスです。',
    url: 'https://atgp.jp/',
    label: 'atGP（アットジーピー）',
  },
  {
    name: 'かべなし求人ナビ',
    desc: '障害や難病のある方向けの求人情報を掲載しています。',
    url: 'https://dei-go.com/jobs',  // ← 正しいURLを確認してください
    label: 'かべなし求人ナビ',
  },
];
---
<Base title="実際にある仕事を見てみる">
  <main class="main-content">

    <div class="page-header">
      <a href={`${base}/`} class="back-link">← もどる</a>
      <h1>実際にある仕事を、少し見てみる</h1>
      <p class="page-desc">
        気になったものがあれば、スタッフに声をかけてみてください。<br />
        見るだけでも、なんとなく眺めるだけでもだいじょうぶです。
      </p>
    </div>

    <!-- 求人票の見方へのリンク -->
    {guides.length > 0 && (
      <div class="guides-row">
        {guides.map(g => (
          <a href={`${base}/guides/${g.id}/`} class="guide-chip">
            📄 {g.data.title}
          </a>
        ))}
      </div>
    )}

    <!-- 今週の求人 -->
    {jobs.length > 0 ? (
      <section class="section">
        <h2 class="section-title">今週の求人</h2>
        <div class="cards-grid">
          {jobs.map((job: any) => (
            <JobCard
              jobNumber={job.job_number ?? ''}
              title={job.title ?? ''}
              company={job.company ?? ''}
              location={job.location ?? ''}
              employmentType={job.employment_type ?? ''}
              hoursText={job.hours_text ?? ''}
              detailUrl={job.detail_url ?? ''}
              matchedConditions={job.matched_conditions ?? ''}
            />
          ))}
        </div>
      </section>
    ) : (
      <div class="empty">
        <p>現在、掲載できる求人情報がありません。</p>
        <p>スタッフに相談してみてください。</p>
      </div>
    )}

    <!-- 外部サービスリンク -->
    <section class="section">
      <h2 class="section-title">ほかのサービスで探してみる</h2>
      <p class="section-note">
        ハローワーク以外にも、障害のある方向けの求人サービスがあります。<br />
        それぞれ特徴があるので、のぞいてみるだけでも参考になるかもしれません。
      </p>
      <div class="ext-links">
        {externalLinks.map(link => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ext-card"
          >
            <span class="ext-name">{link.name}</span>
            <span class="ext-label">{link.label}</span>
            <span class="ext-desc">{link.desc}</span>
            <span class="ext-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

  </main>
</Base>

<style>
  .main-content { padding: 0 24px 80px; }

  .page-header {
    max-width: 680px;
    margin: 48px auto 36px;
  }
  .back-link {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--ink);
    opacity: 0.55;
    text-decoration: none;
    margin-bottom: 20px;
  }
  .back-link:hover { opacity: 1; }
  h1 {
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .page-desc {
    font-size: 0.9rem;
    line-height: 2;
    opacity: 0.75;
  }

  /* ガイドチップ */
  .guides-row {
    max-width: 860px;
    margin: 0 auto 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .guide-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--ink);
    background: var(--rose-tint);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 6px 16px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .guide-chip:hover { background: var(--line); }

  /* セクション */
  .section { max-width: 860px; margin: 48px auto 0; }
  .section-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .section-note {
    font-size: 0.85rem;
    line-height: 1.9;
    opacity: 0.65;
    margin-bottom: 20px;
  }

  /* 求人グリッド */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* 外部リンクカード */
  .ext-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .ext-links { grid-template-columns: repeat(2, 1fr); }
  }
  .ext-card {
    display: grid;
    grid-template-areas:
      "name arrow"
      "label arrow"
      "desc desc";
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
    padding: 20px 22px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s, background 0.15s;
  }
  .ext-card:hover { border-color: var(--rose); background: var(--rose-tint); }
  .ext-name {
    grid-area: name;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .ext-label {
    grid-area: label;
    font-size: 0.72rem;
    opacity: 0.5;
  }
  .ext-desc {
    grid-area: desc;
    font-size: 0.82rem;
    line-height: 1.7;
    opacity: 0.75;
    margin-top: 8px;
  }
  .ext-arrow {
    grid-area: arrow;
    align-self: center;
    font-size: 1rem;
    opacity: 0.4;
  }
  .ext-card:hover .ext-arrow { opacity: 1; }

  .empty {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding: 48px 0;
    font-size: 0.95rem;
    line-height: 2;
    opacity: 0.6;
  }
</style>
