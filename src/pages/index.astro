---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkStyleCard from '../components/WorkStyleCard.astro';
import { getCollection, render } from 'astro:content';

const workStyles = await getCollection('workStyles');
const accommodations = await getCollection('accommodations');
const columns = await getCollection('columns');

const base = import.meta.env.BASE_URL;
---
<Base>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">FIDIA PARTNERS</p>
      <h1 class="hero-copy">
        自分のことを少し知る。<br />
        その先に、<ruby>働<rt>はたら</rt></ruby>き方が見えてくる。
      </h1>
      <p class="hero-desc">
        このサイトは、今すぐ<ruby>就職<rt>しゅうしょく</rt></ruby>を決めるためのものではありません。<br />
        体調のこと、<ruby>暮<rt>く</rt></ruby>らしのこと、今の作業のこと、仕事のこと。<br />
        少しずつ知りながら、「自分はどうしたいのか」「どんな<ruby>働<rt>はたら</rt></ruby>き方なら考えられそうか」を、ゆっくり見つけていくための場所です。<br />
        まだ言葉になっていない気持ちも、少しずつでだいじょうぶです。
      </p>
    </div>
  </section>

  <main class="main-content">

    <!-- 01 働き方の見本 -->
    <section class="section">
      <SectionHeader number="01" title="こんな働き方があります" />
      <div class="cards-grid">
        {workStyles.map(ws => (
          <WorkStyleCard
            title={ws.data.title}
            tags={ws.data.tags}
            hours={ws.data.hours}
            days={ws.data.days}
            place={ws.data.place}
            summary={ws.data.summary}
          />
        ))}
      </div>
    </section>

    <!-- 02 配慮の例 -->
    <section class="section">
      <SectionHeader number="02" title="こんな相談をしていいです" />
      <div class="prose-stack">
        {accommodations.map(async (ac) => {
          const { Content } = await render(ac);
          return (
            <div class="prose-card">
              <h3>{ac.data.title}</h3>
              <div class="prose"><Content /></div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 03 求人バナー（1クッション） -->
    <section class="section">
      <a href={`${base}jobs/`} class="jobs-banner" aria-label="実際にある仕事を見てみるページへ">
        <div class="jobs-banner-inner">
          <p class="jobs-banner-title">実際にある仕事を、少し見てみる</p>
          <p class="jobs-banner-desc">
            気が向いたときに、のぞくだけでだいじょうぶです。
          </p>
          <span class="jobs-banner-cta">見てみる →</span>
        </div>
      </a>
    </section>

    <!-- 読みもの -->
    <section class="section">
      <SectionHeader number="03" title="読みもの" />
      <div class="prose-stack">
        {columns.map(async (col) => {
          const { Content } = await render(col);
          return (
            <div class="prose-card">
              {col.data.kind && <span class="col-kind">{col.data.kind}</span>}
              <h3>{col.data.title}</h3>
              <div class="prose"><Content /></div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 相談 -->
    <section class="section section-consult">
      <SectionHeader number="04" title="気になったら相談していいです" />
      <div class="consult-inner">
        <p>
          「この仕事、どんな感じか聞いてみたい」<br />
          「こういう働き方、自分にできるかな」<br />
          そう思ったら、スタッフに声をかけてみてください。答えを出す必要はありません。
        </p>
        <p class="consult-example">
          たとえばこんな一言でも大丈夫です：<br />
          <em>「ちょっと気になることがあって…」</em>
        </p>
      </div>
    </section>

  </main>
</Base>

<style>
  .hero {
    padding: 56px 24px 48px;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    max-width: var(--max-text);
    margin: 0 auto;
  }
  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--rose);
    margin-bottom: 16px;
  }
  .hero-copy {
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 700;
    line-height: 1.55;
    margin-bottom: 28px;
  }
  .hero-desc {
    font-size: 0.95rem;
    line-height: 2;
    opacity: 0.85;
  }

  .main-content { padding: 0 24px 60px; }
  .section {
    max-width: 860px;
    margin: 64px auto 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .prose-stack { display: flex; flex-direction: column; gap: 16px; }
  .prose-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
  }
  .prose-card h3 { font-size: 1rem; margin-bottom: 10px; }
  .prose { font-size: 0.9rem; line-height: 1.9; }
  .col-kind {
    font-size: 0.7rem;
    background: var(--rose-tint);
    padding: 2px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 8px;
  }

  .section-note {
    font-size: 0.82rem;
    opacity: 0.6;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hw-note {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  .hw-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rose);
  }

  .consult-inner {
    background: var(--rose-tint);
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 0.95rem;
    line-height: 2;
  }
  .consult-example { font-size: 0.9rem; opacity: 0.8; }
  .consult-example em { font-style: normal; font-weight: 500; }

  /* 求人バナー */
  .jobs-banner {
    display: block;
    text-decoration: none;
    color: var(--ink);
    border: 1.5px solid var(--line);
    border-radius: 14px;
    background: #fff;
    transition: border-color 0.2s, background 0.2s;
  }
  .jobs-banner:hover {
    border-color: var(--rose);
    background: var(--rose-tint);
  }
  .jobs-banner-inner {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .jobs-banner-title {
    font-family: 'Zen Maru Gothic', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .jobs-banner-desc {
    font-size: 0.88rem;
    line-height: 1.8;
    opacity: 0.7;
  }
  .jobs-banner-cta {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.55;
  }
  .jobs-banner:hover .jobs-banner-cta { opacity: 1; }
</style>
