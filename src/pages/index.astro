---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkStyleCard from '../components/WorkStyleCard.astro';
import { getCollection, render } from 'astro:content';

const workStyles = await getCollection('workStyles');
const accommodations = await getCollection('accommodations');
const columns = await getCollection('columns');
const voices = await getCollection('voices');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">
        <svg class="eyebrow-flower" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
          <ellipse cx="12" cy="6" rx="2.8" ry="4.5"/>
          <ellipse cx="12" cy="18" rx="2.8" ry="4.5"/>
          <ellipse cx="6" cy="12" rx="4.5" ry="2.8"/>
          <ellipse cx="18" cy="12" rx="4.5" ry="2.8"/>
          <circle cx="12" cy="12" r="2.5"/>
        </svg>
        FIDIA PARTNERS
      </p>
      <h1 class="hero-copy">
        自分のことを少し知る。<br />
        その先に、<ruby>働<rt>はたら</rt></ruby>き方が見えてくる。
      </h1>
      <p class="hero-desc">
        このサイトは、今すぐ<ruby>就職<rt>しゅうしょく</rt></ruby>を決めるためのものではありません。<br />
        体調のこと、<ruby>暮<rt>く</rt></ruby>らしのこと、今の作業のこと、仕事のこと。<br />
        少しずつ知りながら、「自分はどうしたいのか」「どんな<ruby>働<rt>はたら</rt></ruby>き方なら考えられそうか」を、ゆっくり見つけていくための場所です。<br />
        まだ言葉になっていない気持ちも、少しずつでだいじょうぶです。
      </p>
    </div>
  </section>

  <main class="main-content">

    <!-- 01 働き方の見本 -->
    <section class="section">
      <SectionHeader title="こんな働き方があります" />
      <div class="cards-grid">
        {workStyles.map(ws => (
          <WorkStyleCard
            title={ws.data.title}
            tags={ws.data.tags}
            hours={ws.data.hours}
            days={ws.data.days}
            place={ws.data.place}
            summary={ws.data.summary}
          />
        ))}
      </div>
    </section>

    <!-- 02 配慮の例 -->
    <section class="section">
      <SectionHeader title="こんな相談をしていいです" />
      <div class="prose-stack">
        {accommodations.map(async (ac) => {
          const { Content } = await render(ac);
          return (
            <div class="prose-card">
              <h3>{ac.data.title}</h3>
              <div class="prose"><Content /></div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 03 求人バナー（1クッション） -->
    <section class="section">
      <a href={`${base}/jobs/`} class="jobs-banner" aria-label="実際にある仕事を見てみるページへ">
        <div class="jobs-banner-inner">
          <p class="jobs-banner-title">実際にある仕事を、少し見てみる</p>
          <p class="jobs-banner-desc">
            気が向いたときに、のぞくだけでだいじょうぶです。
          </p>
          <span class="jobs-banner-cta">見てみる →</span>
        </div>
      </a>
    </section>

    <!-- 読みもの -->
    <section class="section">
      <SectionHeader title="読みもの" />
      <div class="prose-stack">
        {columns.map(async (col) => {
          const { Content } = await render(col);
          return (
            <div class="prose-card">
              {col.data.kind && <span class="col-kind">{col.data.kind}</span>}
              <h3>{col.data.title}</h3>
              <div class="prose"><Content /></div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 先輩の声 -->
    {voices.length > 0 && (
      <section class="section">
        <SectionHeader title="先輩の声" />
        <div class="voices-grid">
          {voices.map(async (v) => {
            const { Content } = await render(v);
            return (
              <blockquote class="voice-card">
                <p class="voice-quote">「{v.data.quote}」</p>
                <footer class="voice-who">{v.data.who}</footer>
                <div class="voice-body prose"><Content /></div>
              </blockquote>
            );
          })}
        </div>
      </section>
    )}

    <!-- 相談 -->
    <section class="section section-consult">
      <SectionHeader title="気になったら相談していいです" />
      <div class="consult-inner">
        <p>
          「この仕事、どんな感じか聞いてみたい」<br />
          「こういう働き方、自分にできるかな」<br />
          そう思ったら、スタッフに声をかけてみてください。答えを出す必要はありません。
        </p>
        <p class="consult-example">
          たとえばこんな一言でも大丈夫です：<br />
          <em>「ちょっと気になることがあって…」</em>
        </p>
      </div>
    </section>

  </main>
</Base>

<style>
  .hero {
    padding: 56px 24px 56px;
    border-bottom: 1px solid var(--line);
    background-image: radial-gradient(ellipse 55% 90% at 100% 40%, rgba(224, 168, 168, 0.18) 0%, transparent 70%);
  }
  .hero-inner {
    max-width: var(--max-text);
    margin: 0 auto;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--rose);
    margin-bottom: 20px;
  }
  .eyebrow-flower {
    flex-shrink: 0;
    opacity: 0.9;
  }
  .hero-copy {
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 700;
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .hero-desc {
    font-size: 0.95rem;
    line-height: 2.1;
    opacity: 0.8;
    max-width: 560px;
  }

  .main-content { padding: 0 24px 60px; }
  .section {
    max-width: 860px;
    margin: 64px auto 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .prose-stack { display: flex; flex-direction: column; gap: 16px; }
  .prose-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
  }
  .prose-card h3 { font-size: 1rem; margin-bottom: 10px; }
  .prose { font-size: 0.9rem; line-height: 1.9; }
  .col-kind {
    font-size: 0.7rem;
    background: var(--rose-tint);
    padding: 2px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 8px;
  }

  /* 先輩の声 */
  .voices-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .voices-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .voice-card {
    background: var(--rose-tint);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .voice-quote {
    font-family: 'Zen Maru Gothic', sans-serif;
    font-size: 0.97rem;
    font-weight: 500;
    line-height: 1.7;
    color: var(--ink);
  }
  .voice-who {
    font-size: 0.74rem;
    opacity: 0.55;
    letter-spacing: 0.04em;
  }
  .voice-body {
    font-size: 0.85rem;
    line-height: 1.8;
    opacity: 0.75;
    border-top: 1px solid var(--line);
    padding-top: 10px;
    margin-top: 2px;
  }

  .section-note {
    font-size: 0.82rem;
    opacity: 0.6;
    margin-bottom: 20px;
    line-height: 1.7;
  }
  .hw-note {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  .hw-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rose);
  }

  .consult-inner {
    background: var(--rose-tint);
    border-radius: 12px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 0.95rem;
    line-height: 2;
  }
  .consult-example { font-size: 0.9rem; opacity: 0.8; }
  .consult-example em { font-style: normal; font-weight: 500; }

  /* 求人バナー */
  .jobs-banner {
    display: block;
    text-decoration: none;
    color: var(--ink);
    border: 1.5px solid var(--line);
    border-left: 4px solid var(--rose);
    border-radius: 14px;
    background: #fff;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    position: relative;
    overflow: hidden;
  }
  .jobs-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 95% 50%, rgba(224, 168, 168, 0.13) 0%, transparent 70%);
    pointer-events: none;
  }
  .jobs-banner:hover {
    border-color: var(--rose);
    background: var(--rose-tint);
    transform: translateY(-2px);
  }
  .jobs-banner-inner {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 1;
  }
  .jobs-banner-title {
    font-family: 'Zen Maru Gothic', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .jobs-banner-desc {
    font-size: 0.9rem;
    line-height: 1.9;
    opacity: 0.7;
  }
  .jobs-banner-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.55;
    transition: opacity 0.15s, gap 0.15s;
  }
  .jobs-banner:hover .jobs-banner-cta {
    opacity: 1;
    gap: 10px;
  }
</style>
