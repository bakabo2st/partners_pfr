---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(entry => ({ params: { id: entry.id } }));
}

const { id } = Astro.params;
const guides = await getCollection('guides');
const entry = guides.find(g => g.id === id);
if (!entry) return Astro.redirect('/404');

const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={entry.data.title}>
  <main class="main-content">
    <div class="guide-header">
      <a href={`${base}/jobs/`} class="back-link">← 仕事を見てみるページへもどる</a>
      <h1>{entry.data.title}</h1>
    </div>
    <article class="guide-body prose">
      <Content />
    </article>
  </main>
</Base>

<style>
  .main-content { padding: 0 24px 80px; }
  .guide-header {
    max-width: 680px;
    margin: 48px auto 40px;
  }
  .back-link {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--ink);
    opacity: 0.55;
    text-decoration: none;
    margin-bottom: 20px;
  }
  .back-link:hover { opacity: 1; }
  h1 {
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    font-weight: 700;
    line-height: 1.5;
  }
  .guide-body {
    max-width: 680px;
    margin: 0 auto;
  }

  /* Markdown 本文スタイル */
  .prose { font-size: 0.95rem; line-height: 2; }
  .prose h2 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 40px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .prose p { margin-bottom: 16px; }
  .prose strong { font-weight: 700; }
  .prose ul {
    padding-left: 1.4em;
    margin-bottom: 16px;
  }
  .prose li { margin-bottom: 6px; }
</style>
