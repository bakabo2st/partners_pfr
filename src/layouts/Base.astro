---
interface Props {
  title?: string;
}
const { title = '働き方をさがす' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} — FIDIA PARTNERS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink:       #483840;
      --rose:      #E0A8A8;
      --bg:        #FAF6F4;
      --rose-tint: #F7EBEB;
      --line:      #E8DDDB;
      --max-text:  680px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Zen Kaku Gothic New', 'Hiragino Sans', sans-serif;
      font-size: 18px;
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 {
      font-family: 'Zen Maru Gothic', 'Hiragino Maru Gothic Pro', sans-serif;
      line-height: 1.4;
    }
    a { color: var(--ink); }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; display: block; }

    /* ふりがな制御 */
    body.furigana-off rt { visibility: hidden; }
    ruby { white-space: nowrap; }

    /* サイトヘッダー */
    .site-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .site-header .logo-text {
      font-family: 'Zen Maru Gothic', sans-serif;
      font-size: 0.85rem;
      color: var(--ink);
      opacity: 0.75;
      text-decoration: none;
    }
    .furigana-toggle {
      font-size: 0.75rem;
      background: var(--rose-tint);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 4px 14px;
      cursor: pointer;
      color: var(--ink);
      white-space: nowrap;
    }
    .furigana-toggle:hover { background: var(--line); }

    /* フッター */
    .site-footer {
      margin-top: 80px;
      padding: 32px 24px;
      border-top: 1px solid var(--line);
      text-align: center;
      font-size: 0.8rem;
      color: var(--ink);
      opacity: 0.6;
    }
  </style>
</head>
<body class="furigana-off">

<header class="site-header">
  <a href={base} class="logo-text">FIDIA PARTNERS</a>
  <button class="furigana-toggle" id="furiganaToggle" aria-pressed="false">
    ふりがな　オン
  </button>
</header>

<slot />

<footer class="site-footer">
  <p>© FIDIA PARTNERS　就労継続支援B型事業所</p>
  <p style="margin-top:4px;">このサイトは事業所の利用者・関係者向けの情報ページです。</p>
</footer>

<script>
  const btn = document.getElementById('furiganaToggle')!;
  btn.addEventListener('click', () => {
    const isOff = document.body.classList.contains('furigana-off');
    if (isOff) {
      document.body.classList.remove('furigana-off');
      document.body.classList.add('furigana-on');
      btn.textContent = 'ふりがな　オフ';
      btn.setAttribute('aria-pressed', 'true');
    } else {
      document.body.classList.add('furigana-off');
      document.body.classList.remove('furigana-on');
      btn.textContent = 'ふりがな　オン';
      btn.setAttribute('aria-pressed', 'false');
    }
  });
</script>
</body>
</html>
