---
interface Props {
  title: string;
  tags: string[];
  hours?: string;
  days?: string;
  place?: string;
  summary: string;
}
const { title, tags, hours, days, place, summary } = Astro.props;

const placeData: Record<string, { label: string; icon: string }> = {
  '在宅': {
    label: '在宅',
    icon: `<svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M10 2.5L2 9h2v8.5h5v-5h2v5h5V9h2L10 2.5z"/></svg>`,
  },
  '通勤': {
    label: '通勤',
    icon: `<svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><rect x="3" y="4" width="14" height="10" rx="2"/><rect x="6" y="14" width="2" height="3" rx="1"/><rect x="12" y="14" width="2" height="3" rx="1"/></svg>`,
  },
  'どちらも': {
    label: 'どちらも可',
    icon: `<svg viewBox="0 0 20 20" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M10 2.5L2 9h2v8.5h5v-5h2v5h5V9h2L10 2.5z"/></svg>`,
  },
};
---
<article class="work-card">
  <div class="card-top-accent" aria-hidden="true"></div>
  <div class="card-meta">
    {place && placeData[place] && (
      <span class="place-badge" aria-label={`勤務場所: ${placeData[place].label}`}>
        <Fragment set:html={placeData[place].icon} />
        {placeData[place].label}
      </span>
    )}
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-summary">{summary}</p>
  {(hours || days) && (
    <dl class="card-detail">
      {days && <div><dt>日数</dt><dd>{days}</dd></div>}
      {hours && <div><dt>時間</dt><dd>{hours}</dd></div>}
    </dl>
  )}
</article>

<style>
  .work-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .work-card:hover {
    box-shadow: 0 4px 16px rgba(72, 56, 64, 0.07);
    transform: translateY(-2px);
  }
  .card-top-accent {
    height: 3px;
    background: linear-gradient(90deg, var(--rose) 0%, var(--line) 100%);
    border-radius: 12px 12px 0 0;
    margin: 0 -24px 12px;
    opacity: 0.55;
    transition: opacity 0.2s;
  }
  .work-card:hover .card-top-accent { opacity: 1; }
  .card-meta {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    flex-wrap: wrap;
  }
  .place-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--rose-tint);
    color: var(--ink);
    font-size: 0.74rem;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
    font-weight: 500;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-size: 0.72rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 2px 10px;
    color: var(--ink);
    opacity: 0.7;
  }
  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .card-summary {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--ink);
    opacity: 0.82;
  }
  .card-detail {
    display: flex;
    gap: 20px;
    font-size: 0.8rem;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .card-detail div { display: flex; gap: 6px; align-items: baseline; }
  .card-detail dt { opacity: 0.5; }
  .card-detail dd { font-weight: 600; }
</style>
