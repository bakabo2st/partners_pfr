---
interface Props {
  title: string;
  tags: string[];
  hours?: string;
  days?: string;
  place?: string;
  summary: string;
}
const { title, tags, hours, days, place, summary } = Astro.props;

const placeIcon: Record<string, string> = {
  '在宅': '🏠',
  '通勤': '🚌',
  'どちらも': '🏠🚌',
};
---
<article class="work-card">
  <div class="card-meta">
    {place && <span class="place-badge" aria-label={`勤務場所: ${place}`}>{placeIcon[place] ?? ''} {place}</span>}
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-summary">{summary}</p>
  {(hours || days) && (
    <dl class="card-detail">
      {days && <div><dt>日数</dt><dd>{days}</dd></div>}
      {hours && <div><dt>時間</dt><dd>{hours}</dd></div>}
    </dl>
  )}
</article>

<style>
  .work-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card-meta {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    flex-wrap: wrap;
  }
  .place-badge {
    background: var(--rose-tint);
    color: var(--ink);
    font-size: 0.75rem;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-size: 0.72rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 2px 10px;
    color: var(--ink);
    opacity: 0.75;
  }
  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .card-summary {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.85;
  }
  .card-detail {
    display: flex;
    gap: 16px;
    font-size: 0.8rem;
    margin-top: 4px;
  }
  .card-detail div { display: flex; gap: 6px; }
  .card-detail dt { opacity: 0.55; }
  .card-detail dd { font-weight: 500; }
</style>
