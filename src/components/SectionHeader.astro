---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<div class="section-header">
  <span class="section-flower" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="12" cy="6" rx="2.8" ry="4.5"/>
      <ellipse cx="12" cy="18" rx="2.8" ry="4.5"/>
      <ellipse cx="6" cy="12" rx="4.5" ry="2.8"/>
      <ellipse cx="18" cy="12" rx="4.5" ry="2.8"/>
      <circle cx="12" cy="12" r="2.5"/>
    </svg>
  </span>
  <h2>{title}</h2>
  <div class="section-line" aria-hidden="true"></div>
</div>

<style>
  .section-header {
    margin-bottom: 32px;
  }
  .section-flower {
    display: inline-block;
    color: var(--rose);
    margin-bottom: 6px;
    line-height: 1;
  }
  h2 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
  }
  .section-line {
    margin-top: 12px;
    height: 1px;
    background: var(--line);
  }
</style>
